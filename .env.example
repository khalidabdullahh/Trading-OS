# Neon PostgreSQL Production Connection
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & JWT Session Secret (At least 32 characters)
AUTH_SECRET=your_production_auth_secret_must_be_at_least_32_characters_long

# Google OAuth 2.0 Credentials (Server-Side)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://trading-os-blue.vercel.app/api/auth/google/callback

# Gemini AI Engine (Server-Side)
GEMINI_API_KEY=your_gemini_api_key

# Port
PORT=3000
NODE_ENV=production
