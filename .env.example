# Trading-OS v2.0 - Environment Configuration Example

# Server Environment (development / production / test)
NODE_ENV=development
PORT=8088

# PostgreSQL Database Connection String
# e.g. postgresql://username:password@localhost:5432/trading_os?schema=public
DATABASE_URL=

# Google Gemini API Key (Server-Only Secret - Never exposed to client bundle)
# e.g. AIzaSy...
GEMINI_API_KEY=

# Server Authentication Secret (Minimum 32 random characters for JWT signing)
AUTH_SECRET=
